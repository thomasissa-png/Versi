#!/bin/sh
# Guard: la section Gradient de CLAUDE.md doit rester sous 125 lignes (Règle n°7)
# Le contenu custom du projet (hors marqueurs) n'est pas limité.
MAX=125
if [ -f "CLAUDE.md" ]; then
  if grep -q "GRADIENT-AGENTS-START" CLAUDE.md; then
    # Compter uniquement les lignes entre les marqueurs
    LINES=$(sed -n '/GRADIENT-AGENTS-START/,/GRADIENT-AGENTS-END/p' CLAUDE.md | wc -l)
  else
    # Pas de marqueurs = tout le fichier est Gradient
    LINES=$(wc -l < CLAUDE.md)
  fi
  if [ "$LINES" -gt "$MAX" ]; then
    echo "BLOCKED: Gradient section in CLAUDE.md has $LINES lines (max $MAX)."
    echo "Move content to .claude/agents/_base-agent-protocol.md or _gates.md."
    exit 1
  fi
fi

# ────────────────────────────────────────────────────────────────────────────
# Pre-commit s33 Lot D — pipeline QA Versi Studio (G29 / commandement n°6)
# Skip via SKIP_VS_PRECOMMIT=1 git commit (déconseillé, à n'utiliser qu'en
# urgence documentée). Activation : git config core.hooksPath .githooks
# ────────────────────────────────────────────────────────────────────────────

# Skip si versi-studio/ n'est pas dans les fichiers staged
if ! git diff --cached --name-only | grep -q "^versi-studio/"; then
  exit 0
fi

if [ "${SKIP_VS_PRECOMMIT:-0}" = "1" ]; then
  echo "⚠ Pre-commit Versi Studio skippé (SKIP_VS_PRECOMMIT=1)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT/versi-studio" || exit 1

echo "▶ Pre-commit Versi Studio : tsc → lint → test → build (~2-3 min)"

echo "  [1/4] npx tsc --noEmit"
if ! npx tsc --noEmit; then
  echo "❌ COMMIT BLOQUÉ — erreurs TypeScript dans versi-studio/"
  exit 1
fi

echo "  [2/4] npm run lint (ESLint — bloquant, gate G29 PASS s33 Phase 8a)"
# s33 Phase 8a : dette ESLint absorbée (91 errors → 0). Lint désormais bloquant.
# Warnings tolérés (no-unused-vars dans scripts/tests, react-hooks à raffiner).
if ! npm run lint --silent; then
  echo "❌ COMMIT BLOQUÉ — erreurs ESLint dans versi-studio/"
  echo "   Lancez 'npm run lint' pour voir les erreurs, puis corriger avant commit."
  exit 1
fi

echo "  [3/4] npm run test (Vitest)"
if ! npm run test --silent; then
  echo "❌ COMMIT BLOQUÉ — tests Vitest FAIL dans versi-studio/"
  echo "   Bug s33 commit 1da2d78 : ce hook empêche les tests FAIL d'être pushés silencieusement."
  exit 1
fi

echo "  [4/4] npm run build"
if ! npm run build; then
  echo "❌ COMMIT BLOQUÉ — build Next.js FAIL dans versi-studio/"
  exit 1
fi

echo "✓ Pre-commit Versi Studio OK (tsc + lint + test + build)"
