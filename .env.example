# =============================================================================
# Variables d'environnement — Versi (les deux sites)
# =============================================================================
# TOUTES ces variables doivent être dans Replit Secrets, JAMAIS dans .env
# Ce fichier sert uniquement de documentation des variables nécessaires.
# =============================================================================

# --- Base de données (obligatoire) ---
# Fournie automatiquement par Replit quand PostgreSQL est provisionné.
# ATTENTION : peut changer après un redéploiement Replit.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Admin (obligatoire) ---
# Mot de passe pour le backoffice versi-immobilier (/admin)
ADMIN_PASSWORD=un-mot-de-passe-fort-ici

# --- Resend — email transactionnel (obligatoire) ---
# 1. Créer un compte sur resend.com
# 2. Ajouter et vérifier le domaine (versi.fr et/ou versi-immobilier.fr)
# 3. Générer une API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (optionnel — valeurs par défaut fournies) ---
# Adresse expéditrice (doit être sur un domaine vérifié dans Resend)
FROM_EMAIL=formulaire@versi.fr

# Adresse de réception des formulaires versi-immobilier
CONTACT_EMAIL=contact@versi.fr

# Adresse de réception des formulaires versi.fr (holding)
CONTACT_EMAIL_VERSI=contact@versi.fr

# --- Serveur (optionnel) ---
# Port du serveur (Replit l'injecte automatiquement via $PORT)
PORT=3001

# URL publique du site versi-immobilier (pour les liens dans les emails)
SITE_URL=https://versi-immobilier.fr
