{
  "name": "versi",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "postinstall": "cd versi-immobilier && npm install",
    "build": "cd versi-immobilier && npm run build && mkdir -p ../src/dist && cp dist/index.html ../src/dist/index.html",
    "start": "cd versi-immobilier && npm start",
    "dev": "cd versi-immobilier && npm run dev",
    "preview": "cd versi-immobilier && npm run preview",
    "install:app": "cd src && npm install",
    "dev:app": "cd src && npm run dev",
    "build:app": "cd src && npm install && npm run build",
    "start:app": "cd src && npm start"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
